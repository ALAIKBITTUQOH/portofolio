# Salin file ini menjadi .env di folder utama proyek.
# Gunakan Supabase Dashboard > Connect > Transaction Pooler.
# Port: 6543 | User contoh: prisma.<PROJECT-REF>
# Ganti PASSWORD dengan password role prisma yang sudah dibuat di Supabase.
# Jika password mengandung karakter khusus (@, #, /, :, dll.), URL-encode password tersebut.
DATABASE_URL="postgresql://prisma.<PROJECT-REF>:PASSWORD@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
